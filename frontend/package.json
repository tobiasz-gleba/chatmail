{
  "name": "chatmail-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun run typecheck && bun --bun vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "bun test src",
    "preview": "bun --bun vite preview",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts"
  },
  "dependencies": {
    "@animate-ui/react": "^2.4.2",
    "@fontsource-variable/outfit": "^5",
    "input-otp": "^1.5.0",
    "motion": "^14",
    "react": "^19.0.0",
    "react-aria-components": "^1.21.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0"
  }
}
